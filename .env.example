# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://mnp:mnp@localhost:5432/mnp

# TypeSafe AI Jev classifier (https://docs.typesafe.ai)
JEV_API_KEY=
# "jev-latest" follows new releases; pin e.g. jev-1.13.0 to keep answers stable
# JEV_MODEL=jev-latest
# Question set new article versions are classified with (config/questions/<version>.yaml)
# QUESTION_SET=v1.1

# Finnhub market news (free plan: personal use only). Finnhub sources are skipped when empty.
FINNHUB_API_KEY=

# Contact address sent in the User-Agent (SEC and BLS ask automated clients for one)
CONTACT_EMAIL=

LOG_LEVEL=INFO

# Near-duplicate clustering: headline trigram similarity (0-1) and time window
# CLUSTER_SIMILARITY_THRESHOLD=0.6
# CLUSTER_WINDOW_HOURS=48
