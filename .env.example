# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://mnp:mnp@localhost:5432/mnp

# TypeSafe AI Jev classifier (https://docs.typesafe.ai)
JEV_API_KEY=
# "jev-latest" follows new releases; pin e.g. jev-1.13.0 to keep answers stable
# JEV_MODEL=jev-latest
# Question set new article versions are classified with (config/questions/<version>.yaml)
# QUESTION_SET=v1.1

# Finnhub market news (free plan: personal use only). Finnhub sources are skipped when empty.
FINNHUB_API_KEY=

# Contact address sent in the User-Agent (SEC and BLS ask automated clients for one)
CONTACT_EMAIL=

LOG_LEVEL=INFO

# Near-duplicate clustering (see README "Configuration" and `mnp cluster-eval`)
# CLUSTER_METHOD=embedding            # or trigram
# CLUSTER_WINDOW_HOURS=48
# CLUSTER_JOIN_SIMILARITY=0.88        # join at or above this cosine similarity
# CLUSTER_CONFIRM_SIMILARITY=0.78     # between this and JOIN, ask Jev "same event?"
# CLUSTER_CONFIRM_MIN_PROB=0.7        # ...and join if Jev's yes-probability is at least this
# CLUSTER_FALLBACK_SIMILARITY=0.84    # used instead when Jev is unavailable
# CLUSTER_CONFIRM_WITH_JEV=true
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
